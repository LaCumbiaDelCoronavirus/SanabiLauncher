<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mainWindowTabs="clr-namespace:SS14.Launcher.ViewModels.MainWindowTabs"
             xmlns:loc="clr-namespace:SS14.Launcher.Localization"
             xmlns:views="clr-namespace:SS14.Launcher.Views"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="SS14.Launcher.Views.MainWindowTabs.SanabiTabView"
             Name="SanabiTab">
  <Design.DataContext>
    <mainWindowTabs:SanabiTabViewModel/>
  </Design.DataContext>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <DockPanel>
      <StackPanel Orientation="Vertical">
        <!-- PATCHING START -->

        <TextBlock HorizontalAlignment="Center"
                   Text="{loc:Loc tab-sanabi-heading-patching}"
                   Classes="NanoHeading"/>

        <CheckBox VerticalAlignment="Center"
                  Margin="4"
                  IsChecked="{Binding PatchingEnabled}"
                  Content="{loc:Loc tab-sanabi-enable-patching}"/>
        <TextBlock VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{loc:Loc tab-sanabi-enable-patching-desc}"
                   Margin="8"/>

        <!-- <CheckBox VerticalAlignment="Center"
                  Margin="4"
                  IsChecked="{Binding LoadInternalMods}"
                  Content="Enable internal mods"/>
        <TextBlock VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="If patching is enabled, do we patch internal mods; those that come with the launcher?"
                   Margin="8"/> -->

        <CheckBox VerticalAlignment="Center"
                  Margin="4"
                  IsChecked="{Binding PatchingLevel}"
                  Content="{loc:Loc tab-sanabi-patch-content}"/>
        <TextBlock VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{loc:Loc tab-sanabi-patch-content-desc}"
                   Margin="8"/>

        <Separator Classes="horizontal"
                   Margin="0,5,0,5"/>

        <CheckBox VerticalAlignment="Center"
                  Margin="4"
                  IsChecked="{Binding HwidPatchEnabled}"
                  Content="{loc:Loc tab-sanabi-hwid-patch}"/>
        <TextBlock VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{loc:Loc tab-sanabi-hwid-patch-desc}"
                   Margin="8"/>

        <CheckBox VerticalAlignment="Center"
                  Margin="4"
                  IsChecked="{Binding BetterFullscreenPatchEnabled}"
                  Content="{loc:Loc tab-sanabi-fullscreen-patch}"/>
        <TextBlock VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{loc:Loc tab-sanabi-fullscreen-patch-desc}"
                   Margin="8"/>

        <CheckBox VerticalAlignment="Center"
                  Margin="4"
                  IsChecked="{Binding UserDataPatchEnabled}"
                  Content="{loc:Loc tab-sanabi-userdata-virt}"/>
        <TextBlock VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{loc:Loc tab-sanabi-userdata-virt-desc}"
                   Margin="8"/>

        <Separator Classes="horizontal"
                   Margin="0,5,0,5"/>

        <TextBlock HorizontalAlignment="Center"
                   Text="{loc:Loc tab-sanabi-heading-external-mods}"
                   Classes="NanoHeadingMedium"/>

        <CheckBox VerticalAlignment="Center"
                  Margin="4"
                  IsChecked="{Binding LoadExternalMods}"
                  Content="{loc:Loc tab-sanabi-enable-external-mods}"/>
        <TextBlock VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{loc:Loc tab-sanabi-enable-external-mods-desc}"
                   Margin="8"/>

        <TextBlock VerticalAlignment="Center"
                   Foreground="Red"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   Text="{loc:Loc tab-sanabi-external-mods-warning}"
                   Margin="2"/>

        <ScrollViewer DockPanel.Dock="Top">
          <StackPanel Spacing="2">
            <TextBlock DockPanel.Dock="Left"
                       Text="{loc:Loc tab-sanabi-selected-external-mods}"
                       Classes="NanoHeadingSmall"/>
            <Button Content="{loc:Loc tab-sanabi-rescan-mods}"
                    HorizontalAlignment="Center"
                    Command="{Binding RefreshMods}"
                    Margin="0,5,0,10"/>
            <ItemsControl ItemsSource="{Binding PatchList}"
                          Name="Hubs"
                          Classes="Spaced">

              <!-- Template -->
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel>
                    <CheckBox VerticalAlignment="Center"
                              Margin="4"
                              IsChecked="{Binding IsEnabled}"/>
                    <TextBox Text="{Binding Filename}"
                             IsEnabled="False"/>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <Button Content="{loc:Loc tab-sanabi-mod-directory}"
                HorizontalAlignment="Center"
                Command="{Binding OpenModDirectory}"
                Margin="0,10,0,5"/>

        <Separator Classes="horizontal"
                   Margin="0,5,0,5"/>


        <!-- SPOOFING START -->

        <TextBlock HorizontalAlignment="Center"
                   Text="{loc:Loc tab-sanabi-heading-spoofing}"
                   Classes="NanoHeading"/>

        <TextBlock HorizontalAlignment="Center"
                   Text="{loc:Loc tab-sanabi-heading-fingerprint}"
                   Classes="NanoHeadingMedium"/>

        <CheckBox VerticalAlignment="Center"
                  Margin="4"
                  IsChecked="{Binding PassFingerprint}"
                  Content="{loc:Loc tab-sanabi-pass-fingerprint}"/>
        <TextBlock VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{loc:Loc tab-sanabi-pass-fingerprint-desc}"
                   Margin="8"/>

        <CheckBox VerticalAlignment="Center"
                  Margin="4"
                  IsChecked="{Binding PassSpoofedFingerprint}"
                  Content="{loc:Loc tab-sanabi-spoof-fingerprint}"/>
        <TextBlock VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{loc:Loc tab-sanabi-spoof-fingerprint-desc}"
                   Margin="8"/>

        <Separator Classes="horizontal"
                   Margin="0,5,0,5"/>
        <TextBlock HorizontalAlignment="Center"
                   Text="{loc:Loc tab-sanabi-heading-hwid}"
                   Classes="NanoHeadingMedium"/>

        <CheckBox VerticalAlignment="Center"
                  Margin="4"
                  IsChecked="{Binding AllowHwid}"
                  Content="{loc:Loc tab-sanabi-send-hwid}"/>
        <TextBlock VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{loc:Loc tab-sanabi-send-hwid-desc}"
                   Margin="8"/>

        <Separator Classes="horizontal"
                   Margin="0,2,0,2"/>

        <TextBlock VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{loc:Loc tab-sanabi-seed-desc}"
                   Margin="8"/>
        <TextBox Name="UlongBox"
                 Text="{Binding SpoofingSeedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <Button Content="{loc:Loc tab-sanabi-regenerate-seed}"
                DockPanel.Dock="Bottom"
                HorizontalAlignment="Left"
                Command="{Binding RegenerateAccountSeed}"/>

        <Separator Classes="horizontal"
                   Margin="0,5,0,5"/>
        <TextBlock HorizontalAlignment="Center"
                   Text="{loc:Loc tab-sanabi-heading-misc}"
                   Classes="NanoHeadingMedium"/>

        <CheckBox VerticalAlignment="Center"
                  Margin="4"
                  IsChecked="{Binding StartOnLoginMenu}"
                  Content="{loc:Loc tab-sanabi-start-on-login-menu}"/>
        <TextBlock VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{loc:Loc tab-sanabi-start-on-login-menu-desc}"
                   Margin="8"/>

        <CheckBox VerticalAlignment="Center"
                  Margin="4"
                  IsChecked="{Binding PingServers}"
                  Content="{loc:Loc tab-sanabi-ping-servers}"/>
        <TextBlock VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{loc:Loc tab-sanabi-ping-servers-desc}"
                   Margin="8"/>

        <CheckBox VerticalAlignment="Center"
                  Margin="4"
                  IsChecked="{Binding RandomiseServerPingQueryDelay}"
                  Content="{loc:Loc tab-sanabi-randomise-ping-delay}"/>
        <TextBlock VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{loc:Loc tab-sanabi-randomise-ping-delay-desc}"
                   Margin="8"/>

        <!-- VIS. START -->

        <TextBlock HorizontalAlignment="Center"
                   Text="{loc:Loc tab-sanabi-heading-visual}"
                   Classes="NanoHeading"/>

        <CheckBox VerticalAlignment="Center"
                  Margin="4"
                  IsChecked="{Binding FancyBackground}"
                  Content="{loc:Loc tab-sanabi-acrylic-blur}"/>
        <TextBlock VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{loc:Loc tab-sanabi-acrylic-blur-desc}"
                   Margin="8"/>

        <!-- DEBUG START -->

        <TextBlock HorizontalAlignment="Center"
                   Text="{loc:Loc tab-sanabi-heading-debug}"
                   Classes="NanoHeading"/>

        <CheckBox VerticalAlignment="Center"
                  Margin="4"
                  IsChecked="{Binding HarmonyDebug}"
                  Content="{loc:Loc tab-sanabi-debug-mode}"/>
        <TextBlock VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{loc:Loc tab-sanabi-debug-mode-desc}"
                   Margin="8"/>

        <CheckBox VerticalAlignment="Center"
                  Margin="4"
                  IsChecked="{Binding WaitForDebugger}"
                  Content="{loc:Loc tab-sanabi-wait-for-debugger}"/>
        <TextBlock VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{loc:Loc tab-sanabi-wait-for-debugger-desc}"
                   Margin="8"/>

        <Button Content="{loc:Loc tab-sanabi-open-data-directory}"
                HorizontalAlignment="Center"
                Command="{Binding OpenLauncherDataDirectory}"
                Margin="0,10,0,5"/>
      </StackPanel>
    </DockPanel>
  </ScrollViewer>
</UserControl>
