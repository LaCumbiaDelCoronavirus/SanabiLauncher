<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SS14.Launcher.ViewModels"
             xmlns:v="clr-namespace:SS14.Launcher.Views"
             xmlns:loc="clr-namespace:SS14.Launcher.Localization"
             xmlns:mainWindowTabs="clr-namespace:SS14.Launcher.ViewModels.MainWindowTabs"
             xmlns:avalonia="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="SS14.Launcher.Views.MainWindowContent">
  <Design.DataContext>
    <vm:MainWindowViewModel/>
  </Design.DataContext>

  <Panel>
    <Grid IsVisible="{Binding TransitioningImagesVisible}"
          x:Name="ImageTransitionGrid">
      <TransitioningContentControl x:Name="ImageTransition"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   HorizontalContentAlignment="Center"
                                   VerticalContentAlignment="Stretch"/>
    </Grid>

    <Border Background="#80000000"
            DataContext="{Binding HomeTab}"
            IsVisible="{Binding FavoritesListVisible}"
            IsHitTestVisible="False">
    </Border>

    <DockPanel LastChildFill="true">
      <!-- Header -->
      <Panel DockPanel.Dock="Top">

        <DockPanel Name="HeaderPanel"
                   Classes="MainWindowHeader">
          <!-- Logo
          <Image DockPanel.Dock="Left" HorizontalAlignment="Left" Height="60" Margin="0, 0, 0, 8"
                 Source="{DynamicResource LogoLong}" /> -->
          <!--<v:Logo DockPanel.Dock="Left" Height="60" HorizontalAlignment="Left" Margin="0, 8"></v:Logo>-->
          <Grid DockPanel.Dock="Right"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                ColumnDefinitions="Auto, Auto, Auto, Auto"
                Margin="0, 0, 5, 0">
            <!-- Account drop down -->
            <v:AccountDropDown Grid.Column="0"
                               Margin="0, 0, 2, 0"
                               MinWidth="90"
                               DataContext="{Binding AccountDropDown}"/>

            <!-- Discord link -->
            <Button Grid.Column="1"
                    MinWidth="90"
                    Command="{Binding OnDiscordButtonPressed}"
                    Classes="OpenBoth"
                    Margin="0, 0, 2, 0">
              <v:IconLabel Icon="{DynamicResource InfoIcon-discord}"
                           Content="{loc:Loc main-window-header-link-discord}"/>
            </Button>

            <!-- Website link -->
            <Button Grid.Column="2"
                    MinWidth="90"
                    Command="{Binding OnWebsiteButtonPressed}"
                    Classes="OpenLeft"
                    Margin="0, 0, 0, 0">
              <v:IconLabel Icon="{DynamicResource InfoIcon-web}"
                           Content="{loc:Loc main-window-header-link-website}"/>
            </Button>
          </Grid>
        </DockPanel>
      </Panel>

      <Grid>
        <!-- Main tabbed layout when not showing login menu -->
        <TabControl IsVisible="{Binding !ShowLoginMenu}"
                    ItemsSource="{Binding Tabs}"
                    TabStripPlacement="Bottom"
                    SelectedIndex="{Binding SelectedIndex,Mode=TwoWay}"
                    Margin="0 4 0 0">
          <TabControl.ItemTemplate>
            <DataTemplate DataType="mainWindowTabs:MainWindowTabViewModel">
              <TextBlock Text="{Binding Name}"/>
            </DataTemplate>
          </TabControl.ItemTemplate>
        </TabControl>
        <!-- Login interface when not showing login menu -->
        <v:MainWindowLogin
          IsVisible="{Binding $parent.DataContext.ShowLoginMenu}"
          DataContext="{Binding LoginViewModel}"/>
      </Grid>
    </DockPanel>

    <ContentControl Classes="OverlayBox"
                    IsVisible="{Binding LoginViewModel.Screen.OverlayControl, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ContentControl Content="{Binding LoginViewModel.Screen.OverlayControl}"/>
    </ContentControl>

    <ContentControl Classes="OverlayBox"
                    IsVisible="{Binding LoginViewModel.Screen.Busy}">
      <StackPanel Orientation="Vertical"
                  VerticalAlignment="Center">
        <Viewbox Classes="DungSpinnerBox">
          <!-- Explicitly setting visible to block animations -->
          <v:DungSpinner IsVisible="{Binding LoginViewModel.Screen.Busy}"/>
        </Viewbox>
        <TextBlock Text="{Binding LoginViewModel.Screen.BusyText}"
                   HorizontalAlignment="Center"/>
      </StackPanel>
    </ContentControl>

    <ContentControl Classes="OverlayBox"
                    IsVisible="{Binding OverlayViewModel, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ContentControl Content="{Binding OverlayViewModel}"/>
    </ContentControl>

    <ContentControl Classes="OverlayBox"
                    IsVisible="{Binding BusyTask,Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Orientation="Vertical">
        <Viewbox Classes="DungSpinnerBox">
          <!-- Explicitly setting visible to block animations -->
          <v:DungSpinner DockPanel.Dock="Top"
                         IsVisible="{Binding BusyTask,Converter={x:Static ObjectConverters.IsNotNull}}"/>
        </Viewbox>
        <TextBlock Text="{Binding BusyTask}"
                   HorizontalAlignment="Center"/>
      </StackPanel>
    </ContentControl>

    <ContentControl Classes="OverlayBox"
                    IsVisible="{Binding OutOfDate}">
      <StackPanel Orientation="Vertical">
        <TextBlock HorizontalAlignment="Center"
                   Classes="NanoHeadingMedium"
                   Text="{loc:Loc main-window-out-of-date}"/>
        <TextBlock Margin="0, 10"
                   TextAlignment="Center"
                   Text="{loc:Loc main-window-out-of-date-warning-desc}"
                   TextWrapping="Wrap"/>

        <!-- Changelog -->
        <Border IsVisible="{Binding HasChangelogEntries}"
                Background="{DynamicResource ThemePopupBackgroundBrush}"
                BorderBrush="{DynamicResource ThemeStripebackEdgeBrush}"
                BorderThickness="1"
                MaxWidth="450"
                MaxHeight="220"
                Margin="0, 0, 0, 10">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical"
                        Margin="8">
              <ItemsControl ItemsSource="{Binding ChangelogEntries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:ChangelogEntryViewModel">
                    <StackPanel Orientation="Vertical"
                                Margin="0, 0, 0, 10">
                      <Border BorderBrush="{DynamicResource ThemeStripebackEdgeBrush}"
                              BorderThickness="0, 0, 0, 1"
                              Margin="0, 0, 0, 4">
                        <TextBlock Text="{Binding Version}"
                                   Classes="NanoHeadingMedium"
                                   FontSize="14"
                                   Margin="0, 0, 0, 2"/>
                      </Border>
                      <TextBlock Text="{Binding Changes}"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Image IsVisible="{Binding HasChangelogMedia}"
                     Source="{Binding ChangelogMediaBitmap}"
                     Stretch="Uniform"
                     MaxWidth="420"
                     HorizontalAlignment="Center"
                     Margin="0, 4, 0, 0"/>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <DockPanel LastChildFill="False">
          <Button DockPanel.Dock="Right"
                  Content="{loc:Loc main-window-out-of-date-dismiss}"
                  Command="{Binding ExitPressed}"/>
          <Button DockPanel.Dock="Left"
                  Content="{loc:Loc main-window-out-of-date-download-manual}"
                  Command="{Binding DownloadPressed}"/>
        </DockPanel>
      </StackPanel>
    </ContentControl>

    <!-- Yes I realize the absurdity of having literally 5 of these error overlay controls defined get off my back. -->

    <ContentControl Classes="OverlayBox"
                    IsVisible="{Binding !HasDismissedEarlyAccessWarning.Value}">
      <StackPanel Orientation="Vertical">
        <TextBlock HorizontalAlignment="Center"
                   Classes="NanoHeadingMedium"
                   Text="{loc:Loc main-window-early-access-title}"/>
        <TextBlock Margin="0, 10"
                   TextAlignment="Center"
                   MaxWidth="450"
                   TextWrapping="Wrap"
                   Text="{loc:Loc main-window-early-access-desc}"/>
        <Button Content="{loc:Loc main-window-early-access-accept}"
                Command="{Binding DismissEarlyAccessPressed}"
                HorizontalAlignment="Center"/>
      </StackPanel>
    </ContentControl>

    <ContentControl Classes="OverlayBox"
                    IsVisible="{Binding ShouldShowIntelDegradationWarning}">
      <StackPanel Orientation="Vertical">
        <TextBlock HorizontalAlignment="Center"
                   Classes="NanoHeadingMedium"
                   Text="{loc:Loc main-window-intel-degrade-title}"/>
        <TextBlock Margin="0, 10"
                   TextAlignment="Center"
                   MaxWidth="450"
                   TextWrapping="Wrap"
                   Text="{loc:Loc main-window-intel-degrade-desc}"/>
        <Button Content="{loc:Loc main-window-intel-degrade-accept}"
                Command="{Binding DismissIntelDegradationPressed}"
                HorizontalAlignment="Center"/>
      </StackPanel>
    </ContentControl>

    <ContentControl Classes="OverlayBox"
                    IsVisible="{Binding ShouldShowRosettaWarning}">
      <StackPanel Orientation="Vertical">
        <TextBlock HorizontalAlignment="Center"
                   Classes="NanoHeadingMedium"
                   Text="{loc:Loc main-window-rosetta-title}"/>
        <TextBlock Margin="0, 10"
                   TextAlignment="Center"
                   MaxWidth="450"
                   TextWrapping="Wrap"
                   Text="{loc:Loc main-window-rosetta-desc}"/>
        <Button Content="{loc:Loc main-window-rosetta-accept}"
                Command="{Binding DismissAppleSiliconRosettaPressed}"
                HorizontalAlignment="Center"/>
      </StackPanel>
    </ContentControl>

    <!--
      Literally just keep piling them on it doesn't matter.
      This is way easier than coming up with some horribly over-engineered solution.
      -->

    <v:ConnectingOverlay DataContext="{Binding ConnectingVM}"
                         IsVisible="{Binding $parent.DataContext.ConnectingVM, Converter={x:Static ObjectConverters.IsNotNull}}"/>

    <v:AngleBox HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>

    <ContentControl Classes="OverlayBox"
                    Name="DragDropOverlay"
                    IsVisible="False">
      <TextBlock Text="{loc:Loc main-window-drag-drop-prompt}"/>
    </ContentControl>

    <TextBlock Text="{Binding Version}"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Classes="SubText"
               Margin="6"/>
  </Panel>
</UserControl>
