<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../Launcher.props" />

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SS14.Common/SS14.Common.csproj" />
  </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" />
        <PackageReference Include="Lib.Harmony" />

        <!-- Required for BetterFullscreenPatch -->
        <!-- <PackageReference Include="SpaceWizards.Sdl" PrivateAssets="compile" /> -->
    </ItemGroup>
    <!--
    Release builds ship this assembly into the game process. Map the absolute build paths out of the PDB so
    exception stack traces don't reveal the developer's directory layout.
    -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <PathMap>$(MSBuildProjectDirectory)=Sanabi.Framework</PathMap>
        <!-- SourceLink would embed this machine's checkout path and remote in the PDB. -->
        <EnableSourceLink>false</EnableSourceLink>
    </PropertyGroup>

</Project>