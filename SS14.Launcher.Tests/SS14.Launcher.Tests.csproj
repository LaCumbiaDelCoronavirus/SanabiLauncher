<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Launcher.props" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="nunit"/>
    <PackageReference Include="NUnit.Analyzers"/>
    <PackageReference Include="NUnit3TestAdapter"/>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SS14.Launcher\SS14.Launcher.csproj"/>

    <!--
    Build-only: StealthHarnessTest launches this as a subprocess (it applies process-wide Harmony patches that
    must not run in this test host). ReferenceOutputAssembly=false builds it first without loading its types here.
    -->
    <ProjectReference Include="..\SS14.Launcher.StealthProbe\SS14.Launcher.StealthProbe.csproj" ReferenceOutputAssembly="false"/>

    <!--
    Build-only: LoaderAssemblyIdentityTest inspects the built SS14.Loader.dll's manifest on disk (it must not load
    its types here). ReferenceOutputAssembly=false builds it first so the DLL is present to read.
    -->
    <ProjectReference Include="..\SS14.Loader\SS14.Loader.csproj" ReferenceOutputAssembly="false"/>
  </ItemGroup>

</Project>
